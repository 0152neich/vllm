PYTHON_IMAGE=python:3.12-slim
GATEWAY_PORT=18083
GATEWAY_CONTAINER_PORT=8080

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=llm_gateway
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=replace-with-strong-password
LLM_GATEWAY_DATABASE_URL=postgresql+asyncpg://llm_gateway:replace-with-strong-password@postgres:5432/llm_gateway

REDIS_IMAGE=redis:7-alpine
LLM_GATEWAY_REDIS_URL=redis://redis:6379/0

VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_PORT=8025
VLLM_MODEL_NAME=Qwen/Qwen3-4B-AWQ
VLLM_MAX_MODEL_LEN=24576
VLLM_GPU_MEMORY_UTILIZATION=0.40
VLLM_MAX_NUM_SEQS=16
HF_TOKEN=

LLM_GATEWAY_UPSTREAM_BASE_URL=http://vllm:8025/v1
LLM_GATEWAY_UPSTREAM_API_KEY=
LLM_GATEWAY_KEY_PEPPER=replace-with-random-secret-at-least-32-characters
LLM_GATEWAY_PLATFORM_ADMIN_KEY=replace-with-random-platform-admin-key
